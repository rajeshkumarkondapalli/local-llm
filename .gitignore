__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# The default model (models/model.gguf) is intentionally vendored into the
# repo -- see "Vendoring the model into the repo" in README.md -- so it is
# NOT ignored here. Ignore any other/larger model files you experiment with
# locally instead:
models/*.gguf
!models/model.gguf
models/*.bin

.DS_Store
